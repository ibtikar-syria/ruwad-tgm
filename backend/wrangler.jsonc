{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "d1_databases": [
    {
      "binding": "TELEGRAM_MESSAGES_DB",
      "database_name": "telegram-messages",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../database/telegram-messages/migrations"
    },
    {
      "binding": "MAIN_DB",
      "database_name": "main-database",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../database/main-database/migrations"
    }
  ]
}
